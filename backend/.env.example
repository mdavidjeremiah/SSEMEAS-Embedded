# Copy to .env and edit. Everything is optional for a local demo.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
DEMO_DEVICE_KEY=dev-device-key
BASE_URL=http://localhost:8000
TZ_NAME=Africa/Kampala

# WhatsApp Cloud API (leave empty to print messages instead of sending)
WA_TOKEN=
WA_PHONE_ID=
WA_ALERT_TEMPLATE=tank_alert
WA_CODE_TEMPLATE=verify_code
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Email for password resets (leave empty to print the link instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@ssmeas.local

REMINDER_MINUTES=30
RETENTION_DAYS=90
